# Back-office : à définir dans Vercel (Settings → Environment Variables)
# et, pour le développement, dans un fichier .env.local (non versionné).
ADMIN_PASSWORD=
# Optionnel : clé de signature des sessions (sinon dérivée du mot de passe)
ADMIN_SECRET=
# Ajouté automatiquement par Vercel quand un store Blob est relié au projet
# BLOB_READ_WRITE_TOKEN=
# Seulement si le store Blob a été créé en accès « Public »
# BLOB_ACCESS=public
